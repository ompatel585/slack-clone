# Copy this file to frontend/.env and fill in the values.
# Only variables prefixed with VITE_ are exposed to the browser — never put secrets here.

# Clerk (required) — https://dashboard.clerk.com → API keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

# Backend API base URL
VITE_API_URL=http://localhost:5000/api

# Stream public API key (same value as STREAM_API_KEY in backend/.env)
VITE_STREAM_API_KEY=xxxxxxxxxxxx
