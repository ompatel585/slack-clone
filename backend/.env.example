# Copy this file to backend/.env and fill in the values.

# ── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# ── MongoDB (required) ───────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/slack-clone

# ── Clerk (required) — https://dashboard.clerk.com → API keys
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# ── Stream (required) — https://getstream.io/dashboard
STREAM_API_KEY=xxxxxxxxxxxx
STREAM_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Sentry (optional) — leave empty to disable error reporting
SENTRY_DSN=

# ── Inngest — optional with the local dev server, signing key required in production
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
